# =============================================================================
# دستیار مشاور — تنظیمات ساختِ نسخهٔ سایت (روی لپ‌تاپ)
# کپی کنید: cp .env.production.example .env.production
# مقادیر = همان چیزهایی که سرور دارد (بعد از راه‌اندازی با server/deploy.sh)
# =============================================================================

# آدرس سایت (آی‌پی سرور یا دامنه) — بدون خط تیرهٔ آخر
VITE_SUPABASE_URL=http://YOUR_VPS_IP

# کلید anon — از فایل server/.env سرور، سطر ANON_KEY
VITE_SUPABASE_ANON_KEY=paste-ANON_KEY-from-server-here
