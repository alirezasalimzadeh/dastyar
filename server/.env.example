# =============================================================================
# دستیار مشاور — تنظیمات سرور
# کپی کنید: cp .env.example .env  و مقادیر را پر کنید، سپس: bash make-keys.sh
# =============================================================================

# رمز دیتابیس (باید قوی باشد — خودتان انتخاب کنید)
POSTGRES_PASSWORD=ChangeMe-Strong-2026!

# آدرس سایت (آی‌پی سرور یا دامنه) — بدون http://
SITE_URL=YOUR_VPS_IP_OR_DOMAIN

# کلیدها — با make-keys.sh خودکار پر می‌شوند (دست نزنید):
# JWT_SECRET=
# ANON_KEY=
# SERVICE_ROLE_KEY=
